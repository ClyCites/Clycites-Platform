S3_REGION=us-east-1
S3_BUCKET=clycites-local
S3_ACCESS_KEY=clycites
S3_SECRET_KEY=clycites_local_only
HEDERA_PROVIDER=mock
HEDERA_NETWORK=local
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_TOPIC_ID=
HEDERA_MIRROR_NODE_URL=
HEDERA_SUBMISSION_ENABLED=false
HEDERA_CONFIRMATION_ENABLED=false
HEDERA_MAX_TRANSACTION_FEE_USD=1
HEDERA_USD_PER_HBAR=
HEDERA_CONFIRMATION_TIMEOUT_SECONDS=120
HEDERA_CONFIRMATION_POLL_INTERVAL_SECONDS=5
HEDERA_REFERENCE_SECRET=local-only-hedera-reference-secret-change-me
HEDERA_REFERENCE_SECRET_VERSION=v1
HEDERA_MAINNET_ACKNOWLEDGEMENT=
HEDERA_TOPIC_MEMO=ClyCites traceability integrity anchors
HEDERA_TOPIC_CREATE_MAX_FEE_HBAR=2
LOG_LEVEL=info
ENQUEUE_FOUNDATION_CHECK=true
BUILD_SHA=local
AUTH_ACCESS_TOKEN_SECRET=local-only-access-token-secret-change-me
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_SESSION_TTL_DAYS=30
AUTH_REFRESH_COOKIE_NAME=clycites_refresh
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=lax
QR_PUBLIC_BASE_URL=http://localhost:3000
PAYMENT_ENCRYPTION_KEY_BASE64=bG9jYWwtb25seS1wYXltZW50LWtleS0zMi1ieXRlcyE=

# Local seed credentials. Override these outside disposable development environments.
SEED_STAFF_PASSWORD=ClyCites-local-2026!
