# Shared server configuration
NODE_ENV=development
APP_VERSION=0.1.0
API_PORT=4000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://clycites:clycites_local@localhost:5432/clycites?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=clycites-local
S3_ACCESS_KEY=clycites
S3_SECRET_KEY=clycites_local_only
HEDERA_NETWORK=mock
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_TOPIC_ID=
LOG_LEVEL=info
ENQUEUE_FOUNDATION_CHECK=true
BUILD_SHA=local

# Browser-safe configuration. NEXT_PUBLIC_ values are embedded in the web bundle.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
