# Shared server configuration
NODE_ENV=development
APP_VERSION=0.1.0
API_PORT=4000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=0
API_DOCS_ENABLED=true
DATABASE_URL=postgresql://clycites:clycites_local@localhost:5432/clycites?schema=public
