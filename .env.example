# Shared server configuration
NODE_ENV=development
APP_VERSION=0.1.0
API_PORT=4000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=0
API_DOCS_ENABLED=true
# Tests must use this migration-only database. The default clycites database may contain
# cross-branch Phase 9 objects and is rejected by the API test setup.
DATABASE_URL=postgresql://clycites:clycites_local@localhost:5432/clycites_wp1_history?schema=public
SHADOW_DATABASE_URL=postgresql://clycites:clycites_local@localhost:5432/clycites_shadow?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
