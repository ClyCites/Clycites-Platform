# Shared server configuration
NODE_ENV=development
APP_VERSION=0.1.0
API_PORT=4000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://clycites:clycites_local@localhost:5432/clycites?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=clycites-local
S3_ACCESS_KEY=clycites
S3_SECRET_KEY=clycites_local_only
HEDERA_NETWORK=mock
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_TOPIC_ID=
LOG_LEVEL=info
ENQUEUE_FOUNDATION_CHECK=true
BUILD_SHA=local
AUTH_ACCESS_TOKEN_SECRET=local-only-access-token-secret-change-me
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_SESSION_TTL_DAYS=30
AUTH_REFRESH_COOKIE_NAME=clycites_refresh
QR_PUBLIC_BASE_URL=http://localhost:3000

# Local seed credentials. Override these outside disposable development environments.
SEED_STAFF_PASSWORD=ClyCites-local-2026!
SEED_PLATFORM_ADMIN_EMAIL=platform.admin@clycites.local
SEED_COOPERATIVE_ADMIN_EMAIL=cooperative.admin@clycites.local
SEED_COLLECTION_AGENT_EMAIL=collection.agent@clycites.local
SEED_FINANCE_OFFICER_EMAIL=finance.officer@clycites.local

# Browser-safe configuration. NEXT_PUBLIC_ values are embedded in the web bundle.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
