{
  "name": "@clycites/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src test --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "test:e2e": "vitest run test/credential-lifecycle.spec.ts test/device-auth.spec.ts test/farmer-authentication.spec.ts test/jwt-key-rotation.spec.ts test/location-provenance.spec.ts test/mfa.spec.ts test/phase-one.spec.ts test/phase-two.spec.ts test/phase-three.spec.ts test/phase-four.spec.ts test/phase-five.spec.ts test/phase-six.spec.ts test/phase-seven.spec.ts test/phase-eight.spec.ts test/transformation-attribution.spec.ts test/transformation-hardening.spec.ts test/commerce-composed-path.spec.ts test/commerce-hardening.spec.ts test/anchor-coverage.spec.ts",
    "cli:config": "tsx src/cli/check-hedera-config.ts",
    "cli:anchor": "tsx src/cli/inspect-anchor.ts",
    "cli:reconcile": "tsx src/cli/reconcile-topic.ts",
    "cli:topic-status": "tsx src/cli/topic-status.ts",
    "cli:topic-create": "tsx src/cli/create-hedera-topic.ts",
    "cli:backfill-attribution": "tsx src/cli/backfill-transformation-attribution.ts",
    "openapi:check": "tsx src/cli/check-openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@clycites/auth": "workspace:*",
    "@clycites/contracts": "workspace:*",
    "@clycites/database": "workspace:*",
    "@clycites/hedera": "workspace:*",
    "@clycites/observability": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "6.5.0",
    "@turf/area": "^7.4.0",
    "@turf/centroid": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/kinks": "^7.4.0",
    "argon2": "0.45.0",
    "bullmq": "5.80.9",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jose": "6.2.3",
    "libphonenumber-js": "^1.13.10",
    "otpauth": "^9.5.1",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@clycites/eslint-config": "workspace:*",
    "@clycites/typescript-config": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.0",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "6.0.3",
    "eslint": "catalog:",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
