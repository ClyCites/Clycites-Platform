{
  "name": "@clycites/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "node scripts/run-next.mjs build",
    "start": "node scripts/run-next.mjs start",
    "lint": "eslint . --max-warnings 0",
    "pretypecheck": "node scripts/clean-next-types.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:accessibility": "playwright test --grep @accessibility",
    "test:offline": "playwright test --grep @offline",
    "test:performance": "playwright test --grep @performance"
  },
  "dependencies": {
    "@clycites/contracts": "workspace:*",
    "@clycites/ui": "workspace:*",
    "@hookform/resolvers": "5.4.0",
    "@tanstack/react-query": "5.101.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.4",
    "lucide-react": "^1.25.0",
    "next": "16.2.11",
    "qrcode": "1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.82.0",
    "tailwind-merge": "^3.6.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@clycites/eslint-config": "workspace:*",
    "@clycites/typescript-config": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "catalog:",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "eslint": "catalog:",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
