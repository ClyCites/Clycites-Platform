{
  "name": "@clycites/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src prisma.config.ts --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:volume-fixture": "tsx prisma/volume-fixture.ts",
    "db:volume-fixture:clean": "tsx prisma/volume-fixture-clean.ts",
    "db:attribution-measurements": "tsx prisma/attribution-plan-measurements.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@clycites/hedera": "workspace:*",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@clycites/eslint-config": "workspace:*",
    "@clycites/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "argon2": "0.45.1",
    "dotenv": "17.4.2",
    "eslint": "catalog:",
    "prisma": "7.9.0",
    "tsx": "4.23.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
