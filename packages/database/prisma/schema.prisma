  @@index([status, effectiveFrom, effectiveTo])
}

model DataRetentionDryRun {
  id                       String              @id @default(uuid()) @db.Uuid
  dataRetentionPolicyId    String              @db.Uuid
  policyVersion            Int
  eligibleForDeletion      Int                 @default(0)
  eligibleForAnonymization Int                 @default(0)
  blockedByLegalHold       Int                 @default(0)
  immutableRecordsRetained Int                 @default(0)
  estimatedStorageBytes    BigInt?
  report                   Json
  createdAt                DateTime            @default(now()) @db.Timestamptz(3)
  dataRetentionPolicy      DataRetentionPolicy @relation(fields: [dataRetentionPolicyId], references: [id], onDelete: Restrict)

  @@index([dataRetentionPolicyId, createdAt])
  @@index([createdAt])
}

model DataSubjectRequest {
  id                  String                   @id @default(uuid()) @db.Uuid
  publicId            String                   @unique @db.VarChar(128)
  organizationId      String?                  @db.Uuid
  subjectType         DataSubjectType
  farmerId            String?                  @db.Uuid
  userId              String?                  @db.Uuid
  requestType         DataSubjectRequestType
  status              DataSubjectRequestStatus @default(RECEIVED)
  submittedAt         DateTime                 @default(now()) @db.Timestamptz(3)
  identityVerifiedAt  DateTime?                @db.Timestamptz(3)
  assignedToUserId    String?                  @db.Uuid
  completedAt         DateTime?                @db.Timestamptz(3)
  rejectedAt          DateTime?                @db.Timestamptz(3)
  rejectionReason     String?                  @db.VarChar(1000)
