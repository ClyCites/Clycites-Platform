  status                     PilotStatus              @default(DRAFT)
  crop                       String                   @db.VarChar(80)
  region                     String                   @db.VarChar(120)
  district                   String                   @db.VarChar(120)
  plannedStartDate           DateTime                 @db.Date
  plannedEndDate             DateTime                 @db.Date
  actualStartDate            DateTime?                @db.Date
