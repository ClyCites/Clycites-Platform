  notes                          String?                      @db.VarChar(1000)
  version                        Int                          @default(1)
  lockVersion                    Int                          @default(1)
  supersedesDeliveryId           String?                      @unique @db.Uuid
  createdByUserId                String                       @db.Uuid
  createdAt                      DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt                      DateTime                     @updatedAt @db.Timestamptz(3)
  organization                   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  collectionPoint                CollectionPoint              @relation(fields: [collectionPointId], references: [id], onDelete: Restrict)
  collectionSession              CollectionSession            @relation(fields: [collectionSessionId], references: [id], onDelete: Restrict)
  farmer                         Farmer                       @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  farmerOrganizationMembership   FarmerOrganizationMembership @relation(fields: [farmerOrganizationMembershipId], references: [id], onDelete: Restrict)
  farm                           Farm?                        @relation(fields: [farmId], references: [id], onDelete: Restrict)
  commodity                      Commodity                    @relation(fields: [commodityId], references: [id], onDelete: Restrict)
  commodityForm                  CommodityForm                @relation(fields: [commodityFormId], references: [id], onDelete: Restrict)
  acceptedBy                     User?                        @relation("DeliveryAcceptor", fields: [acceptedByUserId], references: [id], onDelete: Restrict)
  createdBy                      User                         @relation("DeliveryCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  supersedes                     Delivery?                    @relation("DeliveryVersions", fields: [supersedesDeliveryId], references: [id], onDelete: Restrict)
  supersededBy                   Delivery?                    @relation("DeliveryVersions")
  measurements                   DeliveryMeasurement[]
  pricing                        DeliveryPricing?
  qualityMeasurements            DeliveryQualityMeasurement[]
  confirmations                  DeliveryConfirmation[]
  receipts                       DeliveryReceipt[]
