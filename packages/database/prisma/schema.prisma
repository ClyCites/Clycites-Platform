model SystemSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(128)
  value     Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model OutboxEvent {
  id                String             @id @default(uuid()) @db.Uuid
  aggregateType     String             @db.VarChar(128)
  aggregateId       String             @db.Uuid
  eventType         String             @db.VarChar(128)
  schemaVersion     String             @db.VarChar(32)
  payload           Json
  status            OutboxEventStatus  @default(PENDING)
  attemptCount      Int                @default(0)
  nextAttemptAt     DateTime?          @db.Timestamptz(3)
  processedAt       DateTime?          @db.Timestamptz(3)
  lastError         String?
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
  traceabilityEvent TraceabilityEvent?

  @@index([status, nextAttemptAt, createdAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@index([eventType, createdAt])
}

model IdempotencyRecord {
  id                 String   @id @default(uuid()) @db.Uuid
  scopeId            String   @default("global") @db.VarChar(128)
  idempotencyKey     String   @db.VarChar(255)
  requestFingerprint String   @db.VarChar(128)
  responseStatus     Int
  responseBody       Json
  expiresAt          DateTime @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  @@unique([scopeId, idempotencyKey])
  @@index([expiresAt])
  @@index([requestFingerprint])
}

model User {
  id                           String                          @id @default(uuid()) @db.Uuid
  username                     String?                         @unique @db.VarChar(40)
  usernameSetAt                DateTime?                       @db.Timestamptz(3)
  email                        String?                         @unique @db.VarChar(320)
  phone                        String?                         @unique @db.VarChar(32)
  passwordHash                 String?                         @db.VarChar(255)
  firstName                    String                          @db.VarChar(100)
  lastName                     String                          @db.VarChar(100)
  status                       UserStatus                      @default(INVITED)
  accountClass                 AccountClass                    @default(STAFF)
  platformRole                 PlatformRole?
  emailVerifiedAt              DateTime?                       @db.Timestamptz(3)
  phoneVerifiedAt              DateTime?                       @db.Timestamptz(3)
  mfaSecretEncrypted           String?                         @db.Text
  mfaEnrolledAt                DateTime?                       @db.Timestamptz(3)
  lastLoginAt                  DateTime?                       @db.Timestamptz(3)
  createdAt                    DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime                        @updatedAt @db.Timestamptz(3)
  deletedAt                    DateTime?                       @db.Timestamptz(3)
  sessions                     Session[]
  mfaChallenges                MfaChallenge[]
  mfaRecoveryCodes             MfaRecoveryCode[]
  invitations                  UserInvitation[]                @relation("InvitationRecipient")
  issuedInvitations            UserInvitation[]                @relation("InvitationIssuer")
  passwordResets               PasswordReset[]
  emailVerifications           EmailVerification[]
  retiredIdentifiers           RetiredIdentifier[]
  initiatedFarmerAccountResets FarmerAccountReset[]            @relation("FarmerResetInitiator")
  memberships                  OrganizationMembership[]        @relation("MembershipUser")
  invitedMemberships           OrganizationMembership[]        @relation("MembershipInviter")
  farmerProfile                Farmer?                         @relation("FarmerUser")
  registeredFarmers            Farmer[]                        @relation("FarmerRegistrar")
  issuedQrIdentities           FarmerQrIdentity[]              @relation("QrIssuer")
  capturedConsents             FarmerConsent[]                 @relation("ConsentCapturer")
  auditEvents                  AuditEvent[]                    @relation("AuditActor")
  assignedDevices              RegisteredDevice[]              @relation("DeviceAssignee")
  collectionSessions           CollectionSession[]             @relation("CollectionAgent")
  createdDeliveries            Delivery[]                      @relation("DeliveryCreator")
  acceptedDeliveries           Delivery[]                      @relation("DeliveryAcceptor")
  deliveryMeasurements         DeliveryMeasurement[]           @relation("MeasurementCapturer")
  qualityMeasurements          DeliveryQualityMeasurement[]    @relation("QualityCapturer")
  witnessedConfirmations       DeliveryConfirmation[]          @relation("ConfirmationWitness")
  issuedReceipts               DeliveryReceipt[]               @relation("ReceiptIssuer")
  requestedCorrections         DeliveryCorrectionRequest[]     @relation("CorrectionRequester")
  reviewedCorrections          DeliveryCorrectionRequest[]     @relation("CorrectionReviewer")
  offlineOperations            OfflineOperation[]
  createdBatches               ProduceBatch[]                  @relation("BatchCreator")
  completedTransformations     BatchTransformation[]           @relation("TransformationCompleter")
  createdLots                  CooperativeLot[]                @relation("LotCreator")
  qualityInspections           QualityInspection[]             @relation("QualityInspector")
  initiatedTransfers           CustodyTransfer[]               @relation("TransferInitiator")
  receivedTransfers            CustodyTransfer[]               @relation("TransferReceiver")
  traceabilityPublications     TraceabilityPublication[]       @relation("PublicationActor")
  requestedAnchorVerifications AnchorVerification[]            @relation("VerificationRequester")
  createdMarketplaceListings   MarketplaceListing[]            @relation("ListingCreator")
  updatedMarketplaceListings   MarketplaceListing[]            @relation("ListingUpdater")
  recordedListingVersions      MarketplaceListingVersion[]     @relation("ListingVersionRecorder")
  sentListingInvitations       ListingInvitation[]             @relation("InvitationSender")
  submittedOffers              Offer[]                         @relation("OfferSubmitter")
  respondedOffers              Offer[]                         @relation("OfferResponder")
  sellerApprovedContracts      SalesContract[]                 @relation("ContractSellerApprover")
  buyerApprovedContracts       SalesContract[]                 @relation("ContractBuyerApprover")
  requestedContractAmendments  ContractAmendment[]             @relation("AmendmentRequester")
  sellerApprovedAmendments     ContractAmendment[]             @relation("AmendmentSellerApprover")
  buyerApprovedAmendments      ContractAmendment[]             @relation("AmendmentBuyerApprover")
  orderStatusEvents            OrderStatusEvent[]
  completedBuyerInspections    BuyerInspection[]               @relation("BuyerInspector")
  buyerAcceptanceDecisions     BuyerAcceptance[]               @relation("BuyerAcceptanceDecider")
  createdTraceabilityShares    TraceabilityShare[]             @relation("ShareCreator")
  recordedSaleProceeds         SaleProceedsRecord[]            @relation("SaleProceedsRecorder")
  verifiedSaleProceeds         SaleProceedsRecord[]            @relation("SaleProceedsVerifier")
  calculatedSettlements        SettlementRun[]                 @relation("SettlementCalculator")
  submittedSettlements         SettlementRun[]                 @relation("SettlementSubmitter")
  approvedSettlements          SettlementRun[]                 @relation("SettlementApprover")
  rejectedSettlements          SettlementRun[]                 @relation("SettlementRejector")
  settlementStatusEvents       SettlementRunStatusEvent[]
  createdDeductionPolicies     DeductionPolicy[]               @relation("DeductionPolicyCreator")
  approvedDeductionPolicies    DeductionPolicy[]               @relation("DeductionPolicyApprover")
  createdSettlementDeductions  SettlementDeduction[]           @relation("SettlementDeductionCreator")
  approvedSettlementDeductions SettlementDeduction[]           @relation("SettlementDeductionApprover")
  resolvedSettlementExceptions SettlementException[]
  verifiedPaymentMethods       FarmerPaymentMethod[]           @relation("PaymentMethodVerifier")
  createdPaymentMethods        FarmerPaymentMethod[]           @relation("PaymentMethodCreator")
  createdPaymentInstructions   PaymentInstruction[]            @relation("PaymentInstructionCreator")
  approvedPaymentInstructions  PaymentInstruction[]            @relation("PaymentInstructionApprover")
  matchedReconciliations       PaymentReconciliation[]         @relation("ReconciliationMatcher")
  reviewedReconciliations      PaymentReconciliation[]         @relation("ReconciliationReviewer")
  issuedFarmerStatements       FarmerStatement[]               @relation("FarmerStatementIssuer")
  reversedBatchContributions   FarmerBatchContribution[]       @relation("ContributionReverser")
  ownedReadinessGates          PilotReadinessGate[]            @relation("ReadinessGateOwner")
  reviewedReadinessGates       PilotReadinessGate[]            @relation("ReadinessGateReviewer")
  readinessStatusEvents        PilotReadinessGateStatusEvent[]
  createdRetentionPolicies     DataRetentionPolicy[]           @relation("RetentionPolicyCreator")
  approvedRetentionPolicies    DataRetentionPolicy[]           @relation("RetentionPolicyApprover")
  subjectPrivacyRequests       DataSubjectRequest[]            @relation("PrivacyRequestSubject")
  assignedPrivacyRequests      DataSubjectRequest[]            @relation("PrivacyRequestAssignee")
  ownedOperationalIncidents    OperationalIncident[]           @relation("IncidentOwner")
  reportedOperationalIncidents OperationalIncident[]           @relation("IncidentReporter")
  verifiedBackups              BackupVerificationRecord[]      @relation("BackupVerifier")
  changedFeatureFlags          FeatureFlag[]                   @relation("FeatureFlagChanger")
  createdPilots                Pilot[]                         @relation("PilotCreator")
  approvedPilots               Pilot[]                         @relation("PilotApprover")
  pilotStatusEvents            PilotStatusEvent[]
