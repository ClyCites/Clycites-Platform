  @@index([organizationId, status, serverReceivedAt])
  @@index([organizationId, collectionPointId, serverReceivedAt])
  @@index([organizationId, farmerId, serverReceivedAt])
  @@index([collectionSessionId, status, createdAt])
  @@index([supersedesDeliveryId])
}

