model FarmerSettlement {
  id                     String                        @id @default(uuid()) @db.Uuid
  publicId               String                        @unique @db.VarChar(128)
  farmerSettlementNumber String                        @db.VarChar(80)
  settlementRunId        String                        @db.Uuid
  organizationId         String                        @db.Uuid
  farmerId               String                        @db.Uuid
  status                 FarmerSettlementStatus        @default(DRAFT)
  currency               String                        @db.Char(3)
  grossEntitlementMinor  BigInt
  deductionsTotalMinor   BigInt                        @default(0)
  adjustmentsTotalMinor  BigInt                        @default(0)
  netEntitlementMinor    BigInt
  statementVersion       Int                           @default(0)
  approvedAt             DateTime?                     @db.Timestamptz(3)
  paymentStatus          FarmerSettlementPaymentStatus @default(NOT_INSTRUCTED)
  createdAt              DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                      @updatedAt @db.Timestamptz(3)
  settlementRun          SettlementRun                 @relation(fields: [settlementRunId], references: [id], onDelete: Restrict)
  organization           Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  farmer                 Farmer                        @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  deductions             SettlementDeduction[]
  exceptions             SettlementException[]
  paymentInstructions    PaymentInstruction[]
  statements             FarmerStatement[]

  @@unique([settlementRunId, farmerId])
  @@unique([organizationId, farmerSettlementNumber])
  @@index([organizationId, status, paymentStatus, createdAt])
  @@index([farmerId, createdAt])
}

model DeductionPolicy {
  id                    String                @id @default(uuid()) @db.Uuid
  organizationId        String                @db.Uuid
  code                  String                @db.VarChar(80)
  name                  String                @db.VarChar(160)
  description           String                @db.VarChar(500)
  type                  DeductionPolicyType
  basis                 DeductionPolicyBasis
  value                 Decimal               @db.Decimal(20, 8)
  currency              String?               @db.Char(3)
  maximumAmountMinor    BigInt?
  priority              Int                   @default(100)
  status                DeductionPolicyStatus @default(DRAFT)
  effectiveFrom         DateTime              @db.Date
  effectiveTo           DateTime?             @db.Date
  policyVersion         Int
  requiresFarmerConsent Boolean               @default(false)
  createdByUserId       String                @db.Uuid
  approvedByUserId      String?               @db.Uuid
  approvedAt            DateTime?             @db.Timestamptz(3)
  createdAt             DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(3)
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy             User                  @relation("DeductionPolicyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedBy            User?                 @relation("DeductionPolicyApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  settlementDeductions  SettlementDeduction[]

  @@unique([organizationId, code, policyVersion])
  @@index([organizationId, status, effectiveFrom, effectiveTo])
  @@index([organizationId, code, policyVersion])
}

model SettlementDeduction {
  id                 String                    @id @default(uuid()) @db.Uuid
  farmerSettlementId String                    @db.Uuid
  deductionPolicyId  String?                   @db.Uuid
  code               String                    @db.VarChar(80)
  description        String                    @db.VarChar(500)
  basisAmountMinor   BigInt?
  basisQuantity      Decimal?                  @db.Decimal(18, 4)
  rate               Decimal?                  @db.Decimal(20, 8)
  amountMinor        BigInt
  reason             String?                   @db.VarChar(500)
  source             SettlementDeductionSource
  createdByUserId    String?                   @db.Uuid
  approvedByUserId   String?                   @db.Uuid
  createdAt          DateTime                  @default(now()) @db.Timestamptz(3)
  farmerSettlement   FarmerSettlement          @relation(fields: [farmerSettlementId], references: [id], onDelete: Restrict)
  deductionPolicy    DeductionPolicy?          @relation(fields: [deductionPolicyId], references: [id], onDelete: Restrict)
  createdBy          User?                     @relation("SettlementDeductionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedBy         User?                     @relation("SettlementDeductionApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)

  @@index([farmerSettlementId, createdAt])
  @@index([deductionPolicyId])
}

model SettlementException {
  id                 String                      @id @default(uuid()) @db.Uuid
  settlementRunId    String                      @db.Uuid
  farmerSettlementId String?                     @db.Uuid
  orderId            String?                     @db.Uuid
  code               String                      @db.VarChar(120)
  severity           SettlementExceptionSeverity
  status             SettlementExceptionStatus   @default(OPEN)
  waivable           Boolean                     @default(true)
  message            String                      @db.VarChar(1000)
  details            Json
  resolvedByUserId   String?                     @db.Uuid
  resolvedAt         DateTime?                   @db.Timestamptz(3)
  resolution         String?                     @db.VarChar(1000)
  createdAt          DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                    @updatedAt @db.Timestamptz(3)
  settlementRun      SettlementRun               @relation(fields: [settlementRunId], references: [id], onDelete: Restrict)
  farmerSettlement   FarmerSettlement?           @relation(fields: [farmerSettlementId], references: [id], onDelete: Restrict)
  order              SalesOrder?                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  resolvedBy         User?                       @relation(fields: [resolvedByUserId], references: [id], onDelete: Restrict)

  @@index([settlementRunId, status, severity])
  @@index([farmerSettlementId, status])
  @@index([orderId, code])
}

model FarmerPaymentMethod {
  id                         String                    @id @default(uuid()) @db.Uuid
  farmerId                   String                    @db.Uuid
  organizationId             String                    @db.Uuid
  type                       FarmerPaymentMethodType
  provider                   String                    @db.VarChar(120)
  accountHolderName          String                    @db.VarChar(200)
  accountIdentifierEncrypted String?                   @db.Text
  accountIdentifierLast4     String?                   @db.VarChar(4)
  status                     FarmerPaymentMethodStatus @default(PENDING_VERIFICATION)
  isDefault                  Boolean                   @default(false)
  verifiedAt                 DateTime?                 @db.Timestamptz(3)
  verifiedByUserId           String?                   @db.Uuid
  createdByUserId            String                    @db.Uuid
  createdAt                  DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                  @updatedAt @db.Timestamptz(3)
  revokedAt                  DateTime?                 @db.Timestamptz(3)
  farmer                     Farmer                    @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  organization               Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  verifiedBy                 User?                     @relation("PaymentMethodVerifier", fields: [verifiedByUserId], references: [id], onDelete: Restrict)
  createdBy                  User                      @relation("PaymentMethodCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  paymentInstructions        PaymentInstruction[]

  @@index([organizationId, farmerId, status])
  @@index([farmerId, isDefault, status])
}

model PaymentProviderConfiguration {
  id                     String               @id @default(uuid()) @db.Uuid
  organizationId         String               @db.Uuid
  provider               String               @db.VarChar(120)
  configurationReference String?              @db.VarChar(255)
  enabled                Boolean              @default(false)
  createdAt              DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime             @updatedAt @db.Timestamptz(3)
  organization           Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  paymentInstructions    PaymentInstruction[]

  @@unique([organizationId, provider])
  @@index([organizationId, enabled])
}

model PaymentInstruction {
  id                      String                        @id @default(uuid()) @db.Uuid
  publicId                String                        @unique @db.VarChar(128)
  instructionNumber       String                        @db.VarChar(80)
  organizationId          String                        @db.Uuid
  farmerSettlementId      String                        @db.Uuid
  farmerId                String                        @db.Uuid
  paymentMethodId         String                        @db.Uuid
  status                  PaymentInstructionStatus      @default(DRAFT)
  currency                String                        @db.Char(3)
  amountMinor             BigInt
  provider                String                        @db.VarChar(120)
  providerConfigurationId String?                       @db.Uuid
  idempotencyKey          String                        @db.VarChar(255)
  scheduledFor            DateTime?                     @db.Timestamptz(3)
  createdByUserId         String                        @db.Uuid
  approvedByUserId        String?                       @db.Uuid
  approvedAt              DateTime?                     @db.Timestamptz(3)
  submittedAt             DateTime?                     @db.Timestamptz(3)
  completedAt             DateTime?                     @db.Timestamptz(3)
  failedAt                DateTime?                     @db.Timestamptz(3)
  failureCode             String?                       @db.VarChar(120)
  failureMessage          String?                       @db.VarChar(500)
  version                 Int                           @default(1)
  createdAt               DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                      @updatedAt @db.Timestamptz(3)
  organization            Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  farmerSettlement        FarmerSettlement              @relation(fields: [farmerSettlementId], references: [id], onDelete: Restrict)
  farmer                  Farmer                        @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  paymentMethod           FarmerPaymentMethod           @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  providerConfiguration   PaymentProviderConfiguration? @relation(fields: [providerConfigurationId], references: [id], onDelete: Restrict)
  createdBy               User                          @relation("PaymentInstructionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedBy              User?                         @relation("PaymentInstructionApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  attempts                PaymentAttempt[]
  reconciliations         PaymentReconciliation[]

  @@unique([organizationId, instructionNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@index([farmerSettlementId, status])
  @@index([farmerId, status])
}

model PaymentAttempt {
  id                           String                  @id @default(uuid()) @db.Uuid
  paymentInstructionId         String                  @db.Uuid
  attemptNumber                Int
  provider                     String                  @db.VarChar(120)
  status                       PaymentAttemptStatus    @default(CREATED)
  providerRequestReference     String?                 @db.VarChar(255)
  providerTransactionReference String?                 @db.VarChar(255)
  providerStatus               String?                 @db.VarChar(120)
  submittedAt                  DateTime?               @db.Timestamptz(3)
  confirmedAt                  DateTime?               @db.Timestamptz(3)
  failedAt                     DateTime?               @db.Timestamptz(3)
  errorCode                    String?                 @db.VarChar(120)
  errorMessage                 String?                 @db.VarChar(500)
  nextRetryAt                  DateTime?               @db.Timestamptz(3)
  metadata                     Json
  createdAt                    DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime                @updatedAt @db.Timestamptz(3)
  paymentInstruction           PaymentInstruction      @relation(fields: [paymentInstructionId], references: [id], onDelete: Restrict)
  reconciliations              PaymentReconciliation[]

  @@unique([paymentInstructionId, attemptNumber])
  @@index([provider, providerTransactionReference])
  @@index([status, nextRetryAt])
}

model PaymentReconciliation {
  id                   String                      @id @default(uuid()) @db.Uuid
  organizationId       String                      @db.Uuid
  paymentInstructionId String                      @db.Uuid
  paymentAttemptId     String?                     @db.Uuid
  source               PaymentReconciliationSource
  externalReference    String                      @db.VarChar(255)
  currency             String                      @db.Char(3)
  amountMinor          BigInt
  valueDate            DateTime                    @db.Date
  status               PaymentReconciliationStatus @default(UNMATCHED)
  evidenceMetadata     Json
  matchedByUserId      String?                     @db.Uuid
  reviewedByUserId     String?                     @db.Uuid
  reviewedAt           DateTime?                   @db.Timestamptz(3)
  notes                String?                     @db.VarChar(1000)
  createdAt            DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                    @updatedAt @db.Timestamptz(3)
  organization         Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  paymentInstruction   PaymentInstruction          @relation(fields: [paymentInstructionId], references: [id], onDelete: Restrict)
  paymentAttempt       PaymentAttempt?             @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  matchedBy            User?                       @relation("ReconciliationMatcher", fields: [matchedByUserId], references: [id], onDelete: Restrict)
  reviewedBy           User?                       @relation("ReconciliationReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, source, externalReference])
  @@index([organizationId, status, valueDate])
  @@index([paymentInstructionId, status])
  @@index([paymentAttemptId])
}

model FarmerStatement {
  id                 String                @id @default(uuid()) @db.Uuid
  publicId           String                @unique @db.VarChar(128)
  statementNumber    String                @db.VarChar(80)
  farmerSettlementId String                @db.Uuid
  version            Int
  status             FarmerStatementStatus @default(ACTIVE)
  issuedAt           DateTime              @db.Timestamptz(3)
  issuedByUserId     String                @db.Uuid
  documentKey        String?               @db.VarChar(500)
  checksum           String                @db.VarChar(128)
  supersededById     String?               @unique @db.Uuid
  createdAt          DateTime              @default(now()) @db.Timestamptz(3)
  farmerSettlement   FarmerSettlement      @relation(fields: [farmerSettlementId], references: [id], onDelete: Restrict)
  issuedBy           User                  @relation("FarmerStatementIssuer", fields: [issuedByUserId], references: [id], onDelete: Restrict)
  supersededBy       FarmerStatement?      @relation("FarmerStatementVersions", fields: [supersededById], references: [id], onDelete: Restrict)
  supersedes         FarmerStatement[]     @relation("FarmerStatementVersions")

  @@unique([farmerSettlementId, version])
  @@unique([farmerSettlementId, statementNumber])
  @@index([farmerSettlementId, status, issuedAt])
}

model PilotReadinessGate {
  id                  String                          @id @default(uuid()) @db.Uuid
  pilotId             String?                         @db.Uuid
  code                String                          @unique @db.VarChar(100)
  name                String                          @db.VarChar(200)
  description         String                          @db.VarChar(1000)
  category            PilotReadinessCategory
  status              PilotReadinessStatus            @default(NOT_STARTED)
  blocking            Boolean                         @default(true)
  ownerUserId         String?                         @db.Uuid
  reviewedByUserId    String?                         @db.Uuid
  reviewedAt          DateTime?                       @db.Timestamptz(3)
  nextReviewAt        DateTime?                       @db.Timestamptz(3)
  riskLevel           OperationalRiskLevel            @default(MEDIUM)
  notes               String?                         @db.VarChar(2000)
  evidence            Json
  humanReviewRequired Boolean                         @default(false)
  createdAt           DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                        @updatedAt @db.Timestamptz(3)
  owner               User?                           @relation("ReadinessGateOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  reviewedBy          User?                           @relation("ReadinessGateReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  statusEvents        PilotReadinessGateStatusEvent[]
  pilot               Pilot?                          @relation(fields: [pilotId], references: [id], onDelete: Restrict)

  @@index([status, blocking, riskLevel])
  @@index([category, status])
  @@index([ownerUserId, status])
  @@index([nextReviewAt])
  @@index([pilotId, status, blocking])
}

model PilotReadinessGateStatusEvent {
  id              String                @id @default(uuid()) @db.Uuid
  readinessGateId String                @db.Uuid
  fromStatus      PilotReadinessStatus?
  toStatus        PilotReadinessStatus
  actorUserId     String                @db.Uuid
  evidence        Json
  riskNotes       String?               @db.VarChar(2000)
  occurredAt      DateTime              @default(now()) @db.Timestamptz(3)
  readinessGate   PilotReadinessGate    @relation(fields: [readinessGateId], references: [id], onDelete: Restrict)
  actorUser       User                  @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([readinessGateId, occurredAt])
  @@index([actorUserId, occurredAt])
}

model DataRetentionPolicy {
  id                  String                    @id @default(uuid()) @db.Uuid
  organizationId      String?                   @db.Uuid
  dataCategory        String                    @db.VarChar(100)
  retentionDays       Int
  archiveAfterDays    Int?
  deletionMode        DataRetentionDeletionMode
  legalHoldSupported  Boolean                   @default(true)
  status              DataRetentionPolicyStatus @default(DRAFT)
  policyVersion       Int
  effectiveFrom       DateTime                  @db.Date
  effectiveTo         DateTime?                 @db.Date
  createdByUserId     String                    @db.Uuid
  approvedByUserId    String?                   @db.Uuid
  approvedAt          DateTime?                 @db.Timestamptz(3)
  createdAt           DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                  @updatedAt @db.Timestamptz(3)
  organization        Organization?             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy           User                      @relation("RetentionPolicyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
