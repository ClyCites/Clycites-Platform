model OperationalIncident {
  id                    String                      @id @default(uuid()) @db.Uuid
  incidentNumber        String                      @unique @db.VarChar(80)
  title                 String                      @db.VarChar(200)
  description           String                      @db.VarChar(4000)
  category              OperationalIncidentCategory
  severity              OperationalIncidentSeverity
  status                OperationalIncidentStatus   @default(OPEN)
  restricted            Boolean                     @default(false)
  organizationId        String?                     @db.Uuid
  detectedAt            DateTime                    @db.Timestamptz(3)
  acknowledgedAt        DateTime?                   @db.Timestamptz(3)
  resolvedAt            DateTime?                   @db.Timestamptz(3)
  ownerUserId           String?                     @db.Uuid
  reportedByUserId      String?                     @db.Uuid
  impactSummary         String?                     @db.VarChar(2000)
  rootCauseSummary      String?                     @db.VarChar(2000)
  resolutionSummary     String?                     @db.VarChar(2000)
  externalReference     String?                     @db.VarChar(255)
  createdAt             DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                    @updatedAt @db.Timestamptz(3)
