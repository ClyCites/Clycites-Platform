  referenceId     String                   @db.Uuid
  occurredAt      DateTime                 @default(now()) @db.Timestamptz(3)
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  commodity       Commodity                @relation(fields: [commodityId], references: [id], onDelete: Restrict)
  commodityForm   CommodityForm            @relation(fields: [commodityFormId], references: [id], onDelete: Restrict)

  @@unique([entryType, referenceType, referenceId])
  @@index([organizationId, sourceType, sourceId, occurredAt])
  @@index([organizationId, destinationType, destinationId, occurredAt])
}

model TraceabilityPublication {
  id              String                        @id @default(uuid()) @db.Uuid
  organizationId  String                        @db.Uuid
  lotId           String                        @unique @db.Uuid
  publicId        String                        @unique @db.VarChar(128)
  status          TraceabilityPublicationStatus @default(PRIVATE)
  publishedClaims Json
  publishedAt     DateTime?                     @db.Timestamptz(3)
  revokedAt       DateTime?                     @db.Timestamptz(3)
  actorUserId     String                        @db.Uuid
  createdAt       DateTime                      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                      @updatedAt @db.Timestamptz(3)
  organization    Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lot             CooperativeLot                @relation(fields: [lotId], references: [id], onDelete: Restrict)
  actor           User                          @relation("PublicationActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, publishedAt])
}

model TraceabilityEvent {
  id                   String        @id @default(uuid()) @db.Uuid
  organizationId       String        @db.Uuid
  outboxEventId        String        @unique @db.Uuid
  entityType           String        @db.VarChar(80)
  entityId             String        @db.Uuid
  eventType            String        @db.VarChar(120)
  schemaVersion        String        @db.VarChar(32)
  canonicalPayload     Json
  canonicalPayloadHash String        @db.VarChar(80)
  previousEventHash    String?       @db.VarChar(80)
  chainPosition        Int
  occurredAt           DateTime      @db.Timestamptz(3)
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)
  organization         Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  outboxEvent          OutboxEvent   @relation(fields: [outboxEventId], references: [id], onDelete: Restrict)
  anchor               HederaAnchor?

  @@unique([organizationId, entityType, entityId, chainPosition])
  @@index([organizationId, eventType, occurredAt])
  @@index([organizationId, entityType, entityId, occurredAt])
  @@index([canonicalPayloadHash])
}

model HederaAnchor {
  id                        String                @id @default(uuid()) @db.Uuid
  anchorEventId             String                @unique @db.Uuid
  traceabilityEventId       String                @unique @db.Uuid
  organizationId            String                @db.Uuid
  entityType                String                @db.VarChar(80)
  entityId                  String                @db.Uuid
  eventType                 String                @db.VarChar(120)
  schemaVersion             String                @db.VarChar(32)
  canonicalPayloadHash      String                @db.VarChar(80)
  previousEventHash         String?               @db.VarChar(80)
  privacyReferenceVersion   String                @db.VarChar(32)
  provider                  HederaAnchorProvider
  network                   HederaNetwork
  topicId                   String?               @db.VarChar(128)
  status                    HederaAnchorStatus    @default(PENDING)
  submissionTransactionId   String?               @db.VarChar(256)
  submissionTransactionHash String?               @db.VarChar(256)
  topicSequenceNumber       BigInt?
  consensusTimestamp        String?               @db.VarChar(64)
  runningHash               String?               @db.VarChar(256)
  runningHashVersion        BigInt?
  submittedAt               DateTime?             @db.Timestamptz(3)
  confirmedAt               DateTime?             @db.Timestamptz(3)
  supersedesAnchorId        String?               @unique @db.Uuid
  lastErrorCode             String?               @db.VarChar(120)
  lastErrorMessage          String?               @db.VarChar(500)
  createdAt                 DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime              @updatedAt @db.Timestamptz(3)
  traceabilityEvent         TraceabilityEvent     @relation(fields: [traceabilityEventId], references: [id], onDelete: Restrict)
  organization              Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supersedesAnchor          HederaAnchor?         @relation("AnchorSupersession", fields: [supersedesAnchorId], references: [id], onDelete: Restrict)
  supersededByAnchor        HederaAnchor?         @relation("AnchorSupersession")
  attempts                  HederaAnchorAttempt[]
  verifications             AnchorVerification[]

  @@unique([provider, network, topicId, topicSequenceNumber])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, entityType, entityId, createdAt])
  @@index([status, createdAt])
  @@index([topicId, topicSequenceNumber])
  @@index([consensusTimestamp])
  @@index([submissionTransactionId])
}

model HederaAnchorAttempt {
  id            String                       @id @default(uuid()) @db.Uuid
  anchorId      String                       @db.Uuid
  attemptNumber Int
  operation     HederaAnchorAttemptOperation
  status        HederaAnchorAttemptStatus
  provider      HederaAnchorProvider
  network       HederaNetwork
  startedAt     DateTime                     @db.Timestamptz(3)
  completedAt   DateTime?                    @db.Timestamptz(3)
  transactionId String?                      @db.VarChar(256)
  errorCode     String?                      @db.VarChar(120)
  errorCategory String?                      @db.VarChar(80)
  errorMessage  String?                      @db.VarChar(500)
  retryAt       DateTime?                    @db.Timestamptz(3)
  metadata      Json
  createdAt     DateTime                     @default(now()) @db.Timestamptz(3)
  anchor        HederaAnchor                 @relation(fields: [anchorId], references: [id], onDelete: Restrict)

  @@unique([anchorId, operation, attemptNumber])
  @@index([anchorId, startedAt])
  @@index([status, retryAt])
}

model HederaTopicCheckpoint {
  id                     String               @id @default(uuid()) @db.Uuid
  provider               HederaAnchorProvider
  network                HederaNetwork
  topicId                String               @db.VarChar(128)
  lastSequenceNumber     BigInt
  lastConsensusTimestamp String               @db.VarChar(64)
  lastRunningHash        String?              @db.VarChar(256)
  checkedAt              DateTime             @db.Timestamptz(3)
  createdAt              DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime             @updatedAt @db.Timestamptz(3)

  @@unique([provider, network, topicId])
  @@index([topicId, lastSequenceNumber])
  @@index([checkedAt])
}

model AnchorVerification {
  id                    String                   @id @default(uuid()) @db.Uuid
  anchorId              String                   @db.Uuid
  verificationType      AnchorVerificationType
  status                AnchorVerificationStatus
  calculatedPayloadHash String                   @db.VarChar(80)
  expectedPayloadHash   String                   @db.VarChar(80)
  mirrorPayloadHash     String?                  @db.VarChar(80)
  chainStatus           AnchorChainStatus
  verifiedAt            DateTime                 @db.Timestamptz(3)
  requestedByUserId     String?                  @db.Uuid
  requestId             String?                  @db.VarChar(128)
  details               Json
  createdAt             DateTime                 @default(now()) @db.Timestamptz(3)
  anchor                HederaAnchor             @relation(fields: [anchorId], references: [id], onDelete: Restrict)
  requestedBy           User?                    @relation("VerificationRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@index([anchorId, verifiedAt])
  @@index([status, verifiedAt])
  @@index([requestedByUserId, verifiedAt])
  @@index([requestId])
}
