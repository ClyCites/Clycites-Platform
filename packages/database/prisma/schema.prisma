generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum PlatformRole {
  PLATFORM_ADMIN
}

enum OrganizationType {
  COOPERATIVE
  BUYER
  PROCESSOR
  EXPORTER
  LOGISTICS_PROVIDER
}

enum OrganizationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrganizationRole {
  COOPERATIVE_ADMIN
  COLLECTION_AGENT
  FINANCE_OFFICER
  QUALITY_INSPECTOR
  BUYER
  VIEWER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum CollectionPointStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum FarmerStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  INACTIVE
  DECEASED
}

enum FarmerMembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  LEFT
}

enum Gender {
  FEMALE
  MALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum AreaUnit {
  ACRE
  HECTARE
}

enum FarmStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum QrIdentityStatus {
  ACTIVE
  REVOKED
  REPLACED
  EXPIRED
}

enum ConsentType {
  DATA_PROCESSING
  SMS_NOTIFICATIONS
  TRACEABILITY
  MARKETPLACE_VISIBILITY
}

enum ConsentStatus {
  GRANTED
  WITHDRAWN
}

enum ConsentCaptureMethod {
  DIGITAL_SIGNATURE
  CHECKBOX
  PAPER_FORM
  VERBAL_WITNESSED
}

enum AuditActorType {
  USER
  SYSTEM
}

enum CommodityStatus {
  ACTIVE
  INACTIVE
}

enum QuantityUnit {
  KG
}

enum QualityDataType {
  DECIMAL
  INTEGER
  TEXT
  ENUM
  BOOLEAN
}

enum ConfigurationStatus {
  ACTIVE
  INACTIVE
}

enum DeviceStatus {
  ACTIVE
  REVOKED
  LOST
  REPLACED
}

enum CollectionSessionStatus {
  OPEN
  CLOSED
  SUSPENDED
}

enum DeliveryStatus {
  DRAFT
  SUBMITTED
  PENDING_CONFIRMATION
  ACCEPTED
  CORRECTION_PENDING
  CORRECTED
  REJECTED
  CANCELLED
}

enum DeliverySource {
  ONLINE
  OFFLINE_SYNC
}

enum DeliveryMeasurementType {
  WEIGHT
}

enum MeasurementCaptureMethod {
  MANUAL
  DEVICE_IMPORT
}

enum PriceSource {
  COLLECTION_POINT
  CONTRACT
  MANUAL_OVERRIDE
}

enum DeliveryConfirmationMethod {
  FARMER_PIN
  SMS_OTP
  SIGNATURE
  VERBAL_WITNESSED
  PRINTED_RECEIPT_ACKNOWLEDGEMENT
}

enum DeliveryConfirmationStatus {
  CONFIRMED
  DECLINED
}

enum DeliveryReceiptStatus {
  ACTIVE
  SUPERSEDED
  VOID
}

enum DeliveryCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DeliveryCorrectionReasonCode {
  WEIGHT_ENTRY_ERROR
  WRONG_FARMER
  WRONG_COMMODITY_FORM
  QUALITY_ENTRY_ERROR
  PRICE_ENTRY_ERROR
  DUPLICATE_DELIVERY
  OTHER
}

enum OfflineOperationStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  REJECTED
  CONFLICT
}

enum OfflineOperationType {
  CREATE_DELIVERY
  CONFIRM_DELIVERY
  SUBMIT_DELIVERY
  REQUEST_DELIVERY_CORRECTION
  CREATE_BATCH
  ADD_BATCH_CONTRIBUTION
}

enum OfflineEntityType {
  DELIVERY
  DELIVERY_CORRECTION
  BATCH
}

enum StorageLocationStatus {
  ACTIVE
  INACTIVE
}

enum ProduceBatchStatus {
  DRAFT
  OPEN
  SEALED
  CONSUMED
  CANCELLED
}

enum BatchOperationType {
  AGGREGATION
  SPLIT
  MERGE
  TRANSFORMATION
}

enum TransformationStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum CooperativeLotStatus {
  DRAFT
  READY
  APPROVED
  CLOSED
  CANCELLED
}

enum QualityInspectionStatus {
  DRAFT
  PASSED
  FAILED
}

enum CustodyTransferStatus {
  DRAFT
  DISPATCHED
  RECEIVED
  REJECTED
  CANCELLED
}

enum TraceabilityPublicationStatus {
  PRIVATE
  PUBLISHED
  REVOKED
}

enum InventoryEntityType {
  DELIVERY
  BATCH
  LOT
}

enum InventoryLedgerEntryType {
  DELIVERY_CONTRIBUTION
  TRANSFORMATION_INPUT
  TRANSFORMATION_OUTPUT
  LOT_ALLOCATION
}

model SystemSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(128)
  value     Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model OutboxEvent {
  id            String            @id @default(uuid()) @db.Uuid
  aggregateType String            @db.VarChar(128)
  aggregateId   String            @db.Uuid
  eventType     String            @db.VarChar(128)
  schemaVersion String            @db.VarChar(32)
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  attemptCount  Int               @default(0)
  nextAttemptAt DateTime?         @db.Timestamptz(3)
  processedAt   DateTime?         @db.Timestamptz(3)
  lastError     String?
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)

  @@index([status, nextAttemptAt, createdAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@index([eventType, createdAt])
}

model IdempotencyRecord {
  id                 String   @id @default(uuid()) @db.Uuid
  scopeId            String   @default("global") @db.VarChar(128)
  idempotencyKey     String   @db.VarChar(255)
  requestFingerprint String   @db.VarChar(128)
  responseStatus     Int
  responseBody       Json
  expiresAt          DateTime @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  @@unique([scopeId, idempotencyKey])
  @@index([expiresAt])
  @@index([requestFingerprint])
}

model User {
  id                       String                       @id @default(uuid()) @db.Uuid
  email                    String?                      @unique @db.VarChar(320)
  phone                    String?                      @db.VarChar(32)
  passwordHash             String                       @db.VarChar(255)
  firstName                String                       @db.VarChar(100)
  lastName                 String                       @db.VarChar(100)
  status                   UserStatus                   @default(INVITED)
  platformRole             PlatformRole?
  emailVerifiedAt          DateTime?                    @db.Timestamptz(3)
  phoneVerifiedAt          DateTime?                    @db.Timestamptz(3)
  lastLoginAt              DateTime?                    @db.Timestamptz(3)
  createdAt                DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                     @updatedAt @db.Timestamptz(3)
  deletedAt                DateTime?                    @db.Timestamptz(3)
  sessions                 Session[]
  memberships              OrganizationMembership[]     @relation("MembershipUser")
  invitedMemberships       OrganizationMembership[]     @relation("MembershipInviter")
  farmerProfile            Farmer?                      @relation("FarmerUser")
  registeredFarmers        Farmer[]                     @relation("FarmerRegistrar")
  issuedQrIdentities       FarmerQrIdentity[]           @relation("QrIssuer")
  capturedConsents         FarmerConsent[]              @relation("ConsentCapturer")
  auditEvents              AuditEvent[]                 @relation("AuditActor")
  assignedDevices          RegisteredDevice[]           @relation("DeviceAssignee")
  collectionSessions       CollectionSession[]          @relation("CollectionAgent")
  createdDeliveries        Delivery[]                   @relation("DeliveryCreator")
  acceptedDeliveries       Delivery[]                   @relation("DeliveryAcceptor")
  deliveryMeasurements     DeliveryMeasurement[]        @relation("MeasurementCapturer")
  qualityMeasurements      DeliveryQualityMeasurement[] @relation("QualityCapturer")
  witnessedConfirmations   DeliveryConfirmation[]       @relation("ConfirmationWitness")
  issuedReceipts           DeliveryReceipt[]            @relation("ReceiptIssuer")
  requestedCorrections     DeliveryCorrectionRequest[]  @relation("CorrectionRequester")
  reviewedCorrections      DeliveryCorrectionRequest[]  @relation("CorrectionReviewer")
  offlineOperations        OfflineOperation[]
  createdBatches           ProduceBatch[]               @relation("BatchCreator")
  completedTransformations BatchTransformation[]        @relation("TransformationCompleter")
  createdLots              CooperativeLot[]             @relation("LotCreator")
  qualityInspections       QualityInspection[]          @relation("QualityInspector")
  initiatedTransfers       CustodyTransfer[]            @relation("TransferInitiator")
  receivedTransfers        CustodyTransfer[]            @relation("TransferReceiver")
  traceabilityPublications TraceabilityPublication[]    @relation("PublicationActor")

  @@index([phone])
  @@index([status, deletedAt])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @db.VarChar(255)
  deviceName       String?   @db.VarChar(160)
  ipAddress        String?   @db.Inet
  userAgent        String?   @db.VarChar(512)
  expiresAt        DateTime  @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model Organization {
  id                       String                         @id @default(uuid()) @db.Uuid
  name                     String                         @db.VarChar(200)
  slug                     String                         @unique @db.VarChar(120)
  type                     OrganizationType
  status                   OrganizationStatus             @default(PENDING)
  registrationNumber       String?                        @db.VarChar(120)
  phone                    String?                        @db.VarChar(32)
  email                    String?                        @db.VarChar(320)
  district                 String?                        @db.VarChar(120)
  subCounty                String?                        @db.VarChar(120)
  address                  String?                        @db.VarChar(500)
  createdAt                DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                       @updatedAt @db.Timestamptz(3)
  deletedAt                DateTime?                      @db.Timestamptz(3)
  memberships              OrganizationMembership[]
  collectionPoints         CollectionPoint[]
  farmerMemberships        FarmerOrganizationMembership[]
  farms                    Farm[]
  qrIdentities             FarmerQrIdentity[]
  consents                 FarmerConsent[]
  auditEvents              AuditEvent[]
  qualityDefinitions       QualityAttributeDefinition[]
  registeredDevices        RegisteredDevice[]
  collectionSessions       CollectionSession[]
  deliveries               Delivery[]
  offlineOperations        OfflineOperation[]
  storageLocations         StorageLocation[]
  produceBatches           ProduceBatch[]
  batchTransformations     BatchTransformation[]
  cooperativeLots          CooperativeLot[]
  qualityInspections       QualityInspection[]
  outgoingCustodyTransfers CustodyTransfer[]              @relation("TransferFromOrganization")
  incomingCustodyTransfers CustodyTransfer[]              @relation("TransferToOrganization")
  inventoryLedgerEntries   InventoryLedgerEntry[]
  traceabilityPublications TraceabilityPublication[]

  @@index([status, type, deletedAt])
  @@index([name])
}

model OrganizationMembership {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @db.Uuid
  userId          String           @db.Uuid
  role            OrganizationRole
  status          MembershipStatus @default(INVITED)
  invitedByUserId String?          @db.Uuid
  joinedAt        DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user            User             @relation("MembershipUser", fields: [userId], references: [id], onDelete: Restrict)
  invitedBy       User?            @relation("MembershipInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status, role])
}

model CollectionPoint {
  id                    String                         @id @default(uuid()) @db.Uuid
  organizationId        String                         @db.Uuid
  name                  String                         @db.VarChar(200)
  code                  String                         @db.VarChar(40)
  status                CollectionPointStatus          @default(ACTIVE)
  district              String                         @db.VarChar(120)
  subCounty             String?                        @db.VarChar(120)
  parish                String?                        @db.VarChar(120)
  village               String?                        @db.VarChar(120)
  latitude              Decimal?                       @db.Decimal(9, 6)
  longitude             Decimal?                       @db.Decimal(10, 6)
  timezone              String                         @default("Africa/Kampala") @db.VarChar(80)
  createdAt             DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                       @updatedAt @db.Timestamptz(3)
  deletedAt             DateTime?                      @db.Timestamptz(3)
  organization          Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  registeredMemberships FarmerOrganizationMembership[]
  collectionSessions    CollectionSession[]
  deliveries            Delivery[]

  @@unique([organizationId, code])
  @@index([organizationId, status, deletedAt])
}

model Farmer {
  id                      String                         @id @default(uuid()) @db.Uuid
  farmerNumber            String                         @unique @db.VarChar(40)
  firstName               String                         @db.VarChar(100)
  middleName              String?                        @db.VarChar(100)
  lastName                String                         @db.VarChar(100)
  preferredName           String?                        @db.VarChar(100)
  gender                  Gender?
  dateOfBirth             DateTime?                      @db.Date
  primaryPhone            String?                        @db.VarChar(32)
  alternativePhone        String?                        @db.VarChar(32)
  email                   String?                        @db.VarChar(320)
  district                String                         @db.VarChar(120)
  subCounty               String?                        @db.VarChar(120)
  parish                  String?                        @db.VarChar(120)
  village                 String?                        @db.VarChar(120)
  status                  FarmerStatus                   @default(DRAFT)
  userId                  String?                        @unique @db.Uuid
  registeredByUserId      String                         @db.Uuid
  createdAt               DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                       @updatedAt @db.Timestamptz(3)
  deletedAt               DateTime?                      @db.Timestamptz(3)
  user                    User?                          @relation("FarmerUser", fields: [userId], references: [id], onDelete: SetNull)
  registeredBy            User                           @relation("FarmerRegistrar", fields: [registeredByUserId], references: [id], onDelete: Restrict)
  organizationMemberships FarmerOrganizationMembership[]
  farms                   Farm[]
  qrIdentities            FarmerQrIdentity[]
  consents                FarmerConsent[]
  deliveries              Delivery[]
  deliveryConfirmations   DeliveryConfirmation[]

  @@index([status, deletedAt])
  @@index([lastName, firstName])
  @@index([primaryPhone])
}

model FarmerOrganizationMembership {
  id                            String                 @id @default(uuid()) @db.Uuid
  farmerId                      String                 @db.Uuid
  organizationId                String                 @db.Uuid
  membershipNumber              String?                @db.VarChar(80)
  status                        FarmerMembershipStatus @default(PENDING)
  joinedAt                      DateTime?              @db.Timestamptz(3)
  leftAt                        DateTime?              @db.Timestamptz(3)
  registeredAtCollectionPointId String?                @db.Uuid
  createdAt                     DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt                     DateTime               @updatedAt @db.Timestamptz(3)
  farmer                        Farmer                 @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  organization                  Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  registeredAtCollectionPoint   CollectionPoint?       @relation(fields: [registeredAtCollectionPointId], references: [id], onDelete: SetNull)
  deliveries                    Delivery[]

  @@unique([farmerId, organizationId])
  @@unique([organizationId, membershipNumber])
  @@index([organizationId, status, createdAt])
  @@index([farmerId, status])
}

model Farm {
  id             String        @id @default(uuid()) @db.Uuid
  farmerId       String        @db.Uuid
  organizationId String?       @db.Uuid
  name           String        @db.VarChar(200)
  district       String        @db.VarChar(120)
  subCounty      String?       @db.VarChar(120)
  parish         String?       @db.VarChar(120)
  village        String?       @db.VarChar(120)
  latitude       Decimal?      @db.Decimal(9, 6)
  longitude      Decimal?      @db.Decimal(10, 6)
  totalArea      Decimal       @db.Decimal(12, 4)
  areaUnit       AreaUnit
  ownershipType  String?       @db.VarChar(80)
  waterSource    String?       @db.VarChar(120)
  status         FarmStatus    @default(ACTIVE)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?     @db.Timestamptz(3)
  farmer         Farmer        @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deliveries     Delivery[]

  @@index([farmerId, status, deletedAt])
  @@index([organizationId, status, deletedAt])
}

model FarmerQrIdentity {
  id             String            @id @default(uuid()) @db.Uuid
  farmerId       String            @db.Uuid
  organizationId String            @db.Uuid
  publicId       String            @unique @db.VarChar(128)
  status         QrIdentityStatus  @default(ACTIVE)
  issuedAt       DateTime          @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime?         @db.Timestamptz(3)
  revokedAt      DateTime?         @db.Timestamptz(3)
  replacedById   String?           @unique @db.Uuid
  issuedByUserId String            @db.Uuid
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)
  farmer         Farmer            @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  issuedBy       User              @relation("QrIssuer", fields: [issuedByUserId], references: [id], onDelete: Restrict)
  replacedBy     FarmerQrIdentity? @relation("QrReplacement", fields: [replacedById], references: [id], onDelete: Restrict)
  replaces       FarmerQrIdentity? @relation("QrReplacement")

  @@index([farmerId, organizationId, status])
  @@index([organizationId, publicId, status])
  @@index([expiresAt])
}

model FarmerConsent {
  id               String               @id @default(uuid()) @db.Uuid
  farmerId         String               @db.Uuid
  organizationId   String               @db.Uuid
  consentType      ConsentType
  policyVersion    String               @db.VarChar(40)
  status           ConsentStatus
  capturedByUserId String               @db.Uuid
  captureMethod    ConsentCaptureMethod
  capturedAt       DateTime             @default(now()) @db.Timestamptz(3)
  withdrawnAt      DateTime?            @db.Timestamptz(3)
  notes            String?              @db.VarChar(1000)
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)
  farmer           Farmer               @relation(fields: [farmerId], references: [id], onDelete: Restrict)
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  capturedBy       User                 @relation("ConsentCapturer", fields: [capturedByUserId], references: [id], onDelete: Restrict)

  @@index([farmerId, organizationId, consentType, capturedAt])
  @@index([organizationId, status, capturedAt])
}

model AuditEvent {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String?        @db.Uuid
  actorUserId    String?        @db.Uuid
  actorType      AuditActorType
  action         String         @db.VarChar(120)
  entityType     String         @db.VarChar(120)
  entityId       String         @db.Uuid
  requestId      String         @db.VarChar(128)
  metadata       Json
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor          User?          @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([requestId])
}

model Commodity {
  id                     String                 @id @default(uuid()) @db.Uuid
  code                   String                 @unique @db.VarChar(40)
  name                   String                 @db.VarChar(120)
  description            String?                @db.VarChar(500)
  status                 CommodityStatus        @default(ACTIVE)
  createdAt              DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime               @updatedAt @db.Timestamptz(3)
  forms                  CommodityForm[]
  deliveries             Delivery[]
  produceBatches         ProduceBatch[]
  cooperativeLots        CooperativeLot[]
  inventoryLedgerEntries InventoryLedgerEntry[]

  @@index([status, code])
}

model CommodityForm {
  id                     String                       @id @default(uuid()) @db.Uuid
  commodityId            String                       @db.Uuid
  code                   String                       @db.VarChar(40)
  name                   String                       @db.VarChar(120)
  description            String?                      @db.VarChar(500)
  defaultUnit            QuantityUnit                 @default(KG)
  status                 CommodityStatus              @default(ACTIVE)
  createdAt              DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                     @updatedAt @db.Timestamptz(3)
  commodity              Commodity                    @relation(fields: [commodityId], references: [id], onDelete: Restrict)
  qualityDefinitions     QualityAttributeDefinition[]
  deliveries             Delivery[]
  produceBatches         ProduceBatch[]
  cooperativeLots        CooperativeLot[]
  inventoryLedgerEntries InventoryLedgerEntry[]

  @@unique([commodityId, code])
  @@index([commodityId, status, code])
}

model QualityAttributeDefinition {
  id                     String                         @id @default(uuid()) @db.Uuid
  commodityFormId        String                         @db.Uuid
  organizationId         String?                        @db.Uuid
  code                   String                         @db.VarChar(60)
  name                   String                         @db.VarChar(120)
  description            String?                        @db.VarChar(500)
  dataType               QualityDataType
  unit                   String?                        @db.VarChar(32)
  required               Boolean                        @default(false)
  minimumValue           Decimal?                       @db.Decimal(18, 6)
  maximumValue           Decimal?                       @db.Decimal(18, 6)
  allowedValues          Json?
  displayOrder           Int                            @default(0)
  status                 ConfigurationStatus            @default(ACTIVE)
  createdAt              DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                       @updatedAt @db.Timestamptz(3)
  commodityForm          CommodityForm                  @relation(fields: [commodityFormId], references: [id], onDelete: Restrict)
  organization           Organization?                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  measurements           DeliveryQualityMeasurement[]
  inspectionMeasurements QualityInspectionMeasurement[]

  @@unique([commodityFormId, organizationId, code])
  @@index([commodityFormId, organizationId, status, displayOrder])
  @@index([organizationId, status, updatedAt])
}

model RegisteredDevice {
  id                String              @id @default(uuid()) @db.Uuid
  organizationId    String              @db.Uuid
  assignedUserId    String              @db.Uuid
  devicePublicId    String              @unique @db.VarChar(128)
  name              String              @db.VarChar(160)
  platform          String              @db.VarChar(80)
  status            DeviceStatus        @default(ACTIVE)
  lastSeenAt        DateTime?           @db.Timestamptz(3)
  registeredAt      DateTime            @default(now()) @db.Timestamptz(3)
  revokedAt         DateTime?           @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignedUser      User                @relation("DeviceAssignee", fields: [assignedUserId], references: [id], onDelete: Restrict)
  sessions          CollectionSession[]
  offlineOperations OfflineOperation[]

  @@index([organizationId, status, assignedUserId])
  @@index([assignedUserId, status, lastSeenAt])
}

model CollectionSession {
  id                String                  @id @default(uuid()) @db.Uuid
  organizationId    String                  @db.Uuid
  collectionPointId String                  @db.Uuid
  agentUserId       String                  @db.Uuid
  deviceId          String                  @db.Uuid
  businessDate      DateTime                @db.Date
  status            CollectionSessionStatus @default(OPEN)
  openedAt          DateTime                @default(now()) @db.Timestamptz(3)
  closedAt          DateTime?               @db.Timestamptz(3)
  notes             String?                 @db.VarChar(1000)
