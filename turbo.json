{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NODE_ENV",
    "APP_VERSION",
    "DATABASE_URL",
    "REDIS_HOST",
    "REDIS_PORT",
    "REDIS_PASSWORD",
    "WEB_ORIGIN",
    "NEXT_PUBLIC_API_BASE_URL",
    "AUTH_ACCESS_TOKEN_SECRET",
    "AUTH_ACCESS_TOKEN_TTL_MINUTES",
    "AUTH_SESSION_TTL_DAYS",
    "AUTH_REFRESH_COOKIE_NAME",
    "QR_PUBLIC_BASE_URL",
    "ENQUEUE_FOUNDATION_CHECK",
    "BUILD_SHA"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "db:generate": {
      "cache": false
    }
  }
}
